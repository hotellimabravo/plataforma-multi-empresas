rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Coleção global de usuários do sistema (validação de tipo e atributos mínimos)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.resource.data.username is string &&
                              request.resource.data.username.size() >= 2 &&
                              request.resource.data.empresaId is string;
      allow delete: if true;
    }

    // Lista de empresas cadastradas no SaaS (validação de integridade)
    match /empresas_lista/{empresaId} {
      allow read: if true;
      allow create, update: if request.resource.data.nome is string &&
                              request.resource.data.nome.size() >= 2 &&
                              request.resource.data.id is string;
      allow delete: if true;
    }

    // Metadados da empresa/tenant
    match /empresas/{empresaId} {
      allow read: if true;
      allow create, update: if request.resource.data.nome is string &&
                              request.resource.data.nome.size() >= 2;
      allow delete: if true;
    }

    // Documentos operacionais da empresa sincronizados em nuvem
    match /empresas/{empresaId}/dados/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.data is string;
      allow delete: if true;
    }
  }
}
